<?xml version="1.0" encoding="utf-8"?>
<!-- Wide portrait screens (tablets, unfolded foldables): the phone's single scrolling column, with
     wider margins and a larger title. Side-by-side columns felt cramped in portrait, so they are
     kept for landscape only (layout-w600dp-land). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:drawableStartCompat="@drawable/ic_settings"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingTop="16dp"
        android:paddingEnd="40dp"
        android:paddingBottom="8dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp">

            <include layout="@layout/section_cities" />

            <View style="@style/SectionDividerStyle" />

            <include layout="@layout/section_background" />

            <View style="@style/SectionDividerStyle" />

            <include layout="@layout/section_battery" />

            <View style="@style/SectionDividerStyle" />

            <include layout="@layout/section_charging" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_bar" />
</LinearLayout>
