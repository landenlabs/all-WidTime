<?xml version="1.0" encoding="utf-8"?>
<!-- One city in the settings list (wide screens): name, UTC offset and time on one line. The
     narrow version in layout/ has the same ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <CheckBox
        android:id="@+id/entry_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/entry_drag"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:contentDescription="@string/drag_to_reorder"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:src="@drawable/ic_drag_handle" />

    <LinearLayout
        android:id="@+id/entry_preview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:baselineAligned="true"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/entry_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/entry_offset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/entry_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:singleLine="true" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/entry_visible"
        style="@style/IconButtonStyle"
        android:contentDescription="@string/show_on_widget"
        android:src="@drawable/ic_visibility" />
</LinearLayout>
