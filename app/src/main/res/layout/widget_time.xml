<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Normal layout: bars, cities / charging / alarm. Hidden in battery-only mode. -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/battery_bar"
            style="@style/BatteryBarStyle"
            android:contentDescription="@string/battery_bar_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp">

            <!-- Normal mode: cities. Hidden while charging or while the unplug alarm is active. -->
            <FrameLayout
                android:id="@+id/city_area"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ListView
                    android:id="@+id/widget_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@null"
                    android:dividerHeight="6dp" />

                <TextView
                    android:id="@+id/widget_empty_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/widget_empty"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Charging: left-justified text, bell (mute alarm for this charge) on the right edge. -->
            <LinearLayout
                android:id="@+id/charging_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/charging_headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/charging_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true" />

                    <!-- Wired only: whether the cable / host carries USB data. -->
                    <TextView
                        android:id="@+id/charging_usb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/charging_bell"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/bell_on_desc"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bell" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alarm_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/alarm_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/widget_alarm_headline"
                    android:textColor="#FFF44336"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alarm_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/widget_alarm_detail" />
            </LinearLayout>
        </FrameLayout>

        <!-- Paired watch's battery (WatchBattery), when this widget shows it and the reading is recent. -->
        <TextView
            android:id="@+id/watch_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/time_left_bar"
            style="@style/BatteryBarStyle"
            android:contentDescription="@string/time_left_bar_label" />

        <!-- Same bottom slot as time left; the two are never on together (temperature wins). -->
        <ImageView
            android:id="@+id/temp_bar"
            style="@style/BatteryBarStyle"
            android:contentDescription="@string/temp_bar_label" />
    </LinearLayout>

    <!-- Big-bar mode (no cities, no time-left bar; level and/or temperature bar on). One bar is
         80% of the widget each way (10% border); two split that height. Text is centered over
         each bar. Spacer weights are 1 + 8 (+ 8) + 1. Taps fall through to widget_root. -->
    <LinearLayout
        android:id="@+id/big_battery_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Spacer (FrameLayout: android.widget.Space is not allowed in RemoteViews). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/big_battery_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="8"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="10">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8">

                <ImageView
                    android:id="@+id/big_battery_bar"
                    style="@style/BigBarStyle" />

                <TextView
                    android:id="@+id/big_battery_text"
                    style="@style/BigBarTextStyle" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/big_temp_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="8"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="10">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8">

                <ImageView
                    android:id="@+id/big_temp_bar"
                    style="@style/BigBarStyle" />

                <TextView
                    android:id="@+id/big_temp_text"
                    style="@style/BigBarTextStyle" />
            </FrameLayout>
        </LinearLayout>

        <!-- Spacer (FrameLayout: android.widget.Space is not allowed in RemoteViews). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
