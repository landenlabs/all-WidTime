<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_city_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/city_search_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/search_city_hint"
        android:inputType="textPostalAddress" />

    <!-- "Searching…" / "Offline: showing built-in cities" -->
    <TextView
        android:id="@+id/search_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/city_results_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/no_matches_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_matches"
        android:visibility="gone" />

    <!-- Attribution required by the Open-Meteo and GeoNames (CC BY 4.0) terms. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/city_search_attribution"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <Button
        android:id="@+id/manual_entry_toggle_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/manual_entry_toggle" />

    <LinearLayout
        android:id="@+id/manual_entry_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/manual_label_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/manual_city_label_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/manual_offset_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/manual_offset_hint"
            android:inputType="text" />

        <Button
            android:id="@+id/manual_entry_confirm_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/use_manual_entry" />
    </LinearLayout>

</LinearLayout>
