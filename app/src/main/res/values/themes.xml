<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WidTime" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.WidTime.Config" parent="Theme.WidTime" />

    <style name="ColorSwatchStyle">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/swatch_shape</item>
    </style>

    <!-- 6dp full-width bar; hidden until enabled in the widget's settings. -->
    <style name="BatteryBarStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:src">@drawable/battery_bar_fill</item>
        <item name="android:background">#33FFFFFF</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
